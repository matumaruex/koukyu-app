{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "builds": [
    {"src": "public/**", "use": "@vercel/static"},
    {"src": "api/*.py", "use": "@vercel/python", "config": {
      "maxDuration": 90,
      "excludeFiles": "{solver/tests/**,solver/results/**,solver/lab.html,user_data.json,work/**}"
    }},
    {"src": "pyproject.toml", "use": "@vercel/python", "config": {
      "excludeFiles": "{solver/tests/**,solver/results/**,solver/lab.html,user_data.json,work/**}"
    }}
  ],
  "routes": [
    {"src": "/(.*)", "headers": {
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "same-origin"
    }, "continue": true},
    {"src": "/", "dest": "/public/index.html", "headers": {"Cache-Control": "no-cache"}},
    {"handle": "filesystem"},
    {"src": "/(.*)", "dest": "/public/$1"}
  ]
}
